/* =========================
   Design tokens
========================= */
:root {
  color-scheme: dark;
  --bg: #080a0d;
  --bg-soft: #0d1015;
  --surface: #12161d;
  --surface-2: #171c24;
  --surface-3: #1d232d;
  --text: #f3f5f7;
  --text-soft: #a7b0be;
  --text-faint: #737e8d;
  --line: #252c36;
  --line-strong: #343d49;
  --accent: #ff6037;
  --accent-strong: #ff744f;
  --accent-soft: rgba(255, 96, 55, 0.13);
  --cyan: #70d6ff;
  --green: #82e6a7;
  --yellow: #ffd166;
  --header: rgba(8, 10, 13, 0.78);
  --shadow: 0 28px 80px rgba(0, 0, 0, 0.32);
  --radius-sm: 10px;
  --radius-md: 18px;
  --radius-lg: 28px;
  --container: 1180px;
  --header-height: 72px;
  --ease: cubic-bezier(0.22, 1, 0.36, 1);
}

:root[data-theme="light"] {
  color-scheme: light;
  --bg: #f6f4ef;
  --bg-soft: #eeece6;
  --surface: #ffffff;
  --surface-2: #f0eee8;
  --surface-3: #e6e2da;
  --text: #17191d;
  --text-soft: #555d68;
  --text-faint: #747c86;
  --line: #d7d3ca;
  --line-strong: #bdb8ad;
  --accent: #e84b24;
  --accent-strong: #ce3814;
  --accent-soft: rgba(232, 75, 36, 0.1);
  --cyan: #007ea8;
  --green: #1b7f4d;
  --yellow: #8d6700;
  --header: rgba(246, 244, 239, 0.82);
  --shadow: 0 28px 70px rgba(31, 28, 22, 0.12);
}

/* =========================
   Reset and base
========================= */
*,
*::before,
*::after {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  scroll-padding-top: calc(var(--header-height) + 20px);
  overflow-x: clip;
}

body {
  margin: 0;
  min-width: 320px;
  overflow-x: clip;
  background: var(--bg);
  color: var(--text);
  font-family: "Manrope", system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-size: 1rem;
  line-height: 1.7;
  text-rendering: optimizeLegibility;
  -webkit-font-smoothing: antialiased;
}

body::before {
  position: fixed;
  inset: 0;
  z-index: -2;
  content: "";
  pointer-events: none;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.018) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.018) 1px, transparent 1px);
  background-size: 56px 56px;
  mask-image: linear-gradient(to bottom, black 0%, transparent 42%);
}

:root[data-theme="light"] body::before {
  background-image:
    linear-gradient(rgba(0, 0, 0, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 0, 0, 0.035) 1px, transparent 1px);
}

img {
  display: block;
  max-width: 100%;
}

svg {
  width: 1.15em;
  height: 1.15em;
  fill: none;
  stroke: currentColor;
  stroke-width: 1.8;
  stroke-linecap: round;
  stroke-linejoin: round;
}

a {
  color: inherit;
  text-decoration: none;
}

button,
input,
textarea {
  font: inherit;
}

button {
  color: inherit;
}

ul,
ol,
dl,
dd {
  margin: 0;
  padding: 0;
}

li {
  list-style: none;
}

h1,
h2,
h3,
p {
  margin-top: 0;
}

h1,
h2,
h3 {
  line-height: 1.12;
  text-wrap: balance;
}

p {
  text-wrap: pretty;
}

::selection {
  background: var(--accent);
  color: #fff;
}

:focus-visible {
  outline: 3px solid var(--cyan);
  outline-offset: 4px;
}

.mono {
  font-family: "JetBrains Mono", Consolas, monospace;
}

.container {
  width: min(100% - 40px, var(--container));
  margin-inline: auto;
}

.section-shell {
  position: relative;
  padding-block: clamp(78px, 11vw, 142px);
}

.section-shell--soft {
  background: var(--bg-soft);
  border-block: 1px solid var(--line);
}

.section-shell--ink {
  background: #0d1117;
  color: #f4f7fa;
}

:root[data-theme="light"] .section-shell--ink {
  background: #15191f;
}

.skip-link {
  position: fixed;
  top: 12px;
  left: 12px;
  z-index: 1000;
  padding: 10px 16px;
  border-radius: var(--radius-sm);
  background: var(--text);
  color: var(--bg);
  transform: translateY(-160%);
  transition: transform 0.2s ease;
}

.skip-link:focus {
  transform: translateY(0);
}

/* =========================
   Header and navigation
========================= */
.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  height: var(--header-height);
  border-bottom: 1px solid transparent;
  background: var(--header);
  backdrop-filter: blur(18px) saturate(150%);
  transition: border-color 0.25s ease, box-shadow 0.25s ease;
}

.site-header.is-scrolled {
  border-color: var(--line);
  box-shadow: 0 10px 32px rgba(0, 0, 0, 0.08);
}

.header__inner {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.brand {
  display: inline-flex;
  align-items: center;
  gap: 2px;
  font-family: "JetBrains Mono", monospace;
  font-size: 1.06rem;
  font-weight: 600;
  letter-spacing: -0.04em;
}

.brand__prompt {
  color: var(--accent);
}

.brand__cursor {
  width: 7px;
  height: 1.1em;
  margin-left: 3px;
  background: var(--accent);
  animation: blink 1.1s steps(1) infinite;
}

.header__actions {
  display: flex;
  align-items: center;
  gap: 8px;
}

.icon-button {
  width: 42px;
  height: 42px;
  display: inline-grid;
  place-items: center;
  padding: 0;
  border: 1px solid var(--line);
  border-radius: 50%;
  background: var(--surface);
  cursor: pointer;
  transition: transform 0.25s var(--ease), border-color 0.25s ease, color 0.25s ease;
}

.icon-button:hover {
  transform: translateY(-2px);
  border-color: var(--accent);
  color: var(--accent);
}

.theme-toggle__sun {
  display: none;
}

:root[data-theme="light"] .theme-toggle__sun {
  display: block;
}

:root[data-theme="light"] .theme-toggle__moon {
  display: none;
}

.menu-toggle {
  position: relative;
  gap: 0;
}

.menu-toggle span {
  position: absolute;
  width: 18px;
  height: 1.5px;
  border-radius: 2px;
  background: currentColor;
  transition: transform 0.3s var(--ease);
}

.menu-toggle span:first-child {
  transform: translateY(-3px);
}

.menu-toggle span:last-child {
  transform: translateY(3px);
}

.menu-toggle[aria-expanded="true"] span:first-child {
  transform: rotate(45deg);
}

.menu-toggle[aria-expanded="true"] span:last-child {
  transform: rotate(-45deg);
}

.nav {
  position: fixed;
  top: var(--header-height);
  right: 0;
  z-index: 102;
  width: min(88vw, 360px);
  height: calc(100dvh - var(--header-height));
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: 4px;
  padding: 28px 24px;
  border-left: 1px solid var(--line);
  background: var(--bg-soft);
  box-shadow: var(--shadow);
  opacity: 0;
  clip-path: inset(0 0 0 100%);
  pointer-events: none;
  visibility: hidden;
  transition: opacity 0.3s ease, clip-path 0.35s var(--ease), visibility 0.35s;
}

.nav.is-open {
  opacity: 1;
  clip-path: inset(0);
  pointer-events: auto;
  visibility: visible;
}

.nav__link {
  padding: 12px 4px;
  border-bottom: 1px solid var(--line);
  color: var(--text-soft);
  font-weight: 600;
}

.nav__link:hover,
.nav__link.is-active {
  color: var(--accent);
}

.nav__resume {
  margin-top: 18px;
  justify-content: center;
}

.nav-backdrop {
  position: fixed;
  inset: var(--header-height) 0 0;
  z-index: 101;
  display: none;
  width: 100%;
  padding: 0;
  border: 0;
  background: rgba(0, 0, 0, 0.56);
  backdrop-filter: blur(3px);
}

.nav-backdrop.is-visible {
  display: block;
}

body.menu-open {
  overflow: hidden;
}

/* =========================
   Buttons and links
========================= */
.button {
  min-height: 48px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 10px;
  padding: 12px 18px;
  border: 1px solid transparent;
  border-radius: 999px;
  background: transparent;
  font-size: 0.92rem;
  font-weight: 700;
  line-height: 1.2;
  cursor: pointer;
  transition: transform 0.25s var(--ease), background 0.25s ease, border-color 0.25s ease, color 0.25s ease, box-shadow 0.25s ease;
}

.button:hover {
  transform: translateY(-2px);
}

.button--small {
  min-height: 38px;
  padding: 8px 14px;
  font-size: 0.82rem;
}

.button--primary {
  background: var(--accent);
  color: #fff;
  box-shadow: 0 10px 30px rgba(255, 96, 55, 0.2);
}

.button--primary:hover {
  background: var(--accent-strong);
  box-shadow: 0 14px 34px rgba(255, 96, 55, 0.28);
}

.button--ghost,
.button--outline {
  border-color: var(--line-strong);
  background: var(--surface);
  color: var(--text);
}

.button--ghost:hover,
.button--outline:hover {
  border-color: var(--accent);
  color: var(--accent);
}

.button--light {
  margin-top: 26px;
  background: #f4f7fa;
  color: #11161d;
}

.button--light:hover {
  background: var(--accent);
  color: #fff;
}

.text-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: var(--text-soft);
  font-weight: 700;
  white-space: nowrap;
}

.text-link span {
  color: var(--accent);
  transition: transform 0.25s var(--ease);
}

.text-link:hover {
  color: var(--text);
}

.text-link:hover span {
  transform: translate(3px, -3px);
}

/* =========================
   Hero
========================= */
.hero {
  min-height: calc(100svh - var(--header-height));
  display: grid;
  align-items: center;
  padding-top: clamp(72px, 10vw, 120px);
  overflow: hidden;
}

.hero__glow {
  position: absolute;
  top: 2%;
  left: 56%;
  width: min(640px, 90vw);
  aspect-ratio: 1;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 96, 55, 0.12), rgba(112, 214, 255, 0.045) 42%, transparent 70%);
  filter: blur(14px);
  pointer-events: none;
}

.hero__grid {
  position: relative;
  display: grid;
  gap: 58px;
  align-items: center;
}

.hero__content {
  max-width: 720px;
}

.eyebrow {
  width: fit-content;
  display: flex;
  align-items: center;
  gap: 9px;
  margin-bottom: 26px;
  padding: 7px 12px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--surface);
  color: var(--text-soft);
  font-size: 0.72rem;
  font-weight: 700;
}

.status-dot {
  flex: 0 0 auto;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: var(--green);
  box-shadow: 0 0 0 5px rgba(130, 230, 167, 0.1);
}

.hero__kicker {
  margin-bottom: 12px;
  color: var(--accent);
  font-size: 0.8rem;
}

.hero h1 {
  max-width: 800px;
  margin-bottom: 24px;
  font-size: clamp(2.55rem, 10vw, 5.4rem);
  letter-spacing: -0.075em;
}

.hero h1 span {
  color: var(--text-soft);
}

.hero__lead {
  max-width: 64ch;
  margin-bottom: 30px;
  color: var(--text-soft);
  font-size: clamp(1rem, 2vw, 1.1rem);
}

.hero__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.hero__facts {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 1px;
  margin-top: 44px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--line);
}

.hero__facts div {
  min-width: 0;
  padding: 17px;
  background: var(--bg);
}

.hero__facts div:last-child {
  grid-column: 1 / -1;
}

.hero__facts dt {
  margin-bottom: 2px;
  color: var(--text);
  font-weight: 800;
}

.hero__facts dd {
  color: var(--text-faint);
  font-size: 0.76rem;
}

.hero__visual {
  position: relative;
  min-width: 0;
}

.hero__scroll {
  position: fixed;
  bottom: 22px;
  left: 50%;
  z-index: 30;
  width: 48px;
  height: 48px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line-strong);
  border-radius: 50%;
  background: color-mix(in srgb, var(--surface) 88%, transparent);
  box-shadow: 0 14px 34px rgba(0, 0, 0, 0.24);
  color: var(--accent);
  backdrop-filter: blur(12px);
  transform: translateX(-50%);
  transition: opacity 0.3s ease, visibility 0.3s ease, border-color 0.25s ease, background 0.25s ease;
}

.hero__scroll:hover {
  border-color: var(--accent);
  background: var(--accent);
  color: #fff;
}

.hero__scroll svg {
  width: 21px;
  height: 21px;
  animation: scroll-cue 1.45s ease-in-out infinite;
}

.hero__scroll.is-hidden {
  opacity: 0;
  visibility: hidden;
  pointer-events: none;
}

.terminal-card {
  position: relative;
  width: 100%;
  overflow: hidden;
  border: 1px solid var(--line-strong);
  border-radius: var(--radius-md);
  background: #10141a;
  box-shadow: var(--shadow);
  transform: perspective(1000px) rotateX(0) rotateY(0);
  transition: transform 0.5s var(--ease), border-color 0.3s ease;
}

.terminal-card:hover {
  border-color: rgba(255, 96, 55, 0.6);
  transform: perspective(1000px) rotateX(1deg) rotateY(-1deg) translateY(-4px);
}

.terminal-card__bar {
  min-width: 0;
  height: 46px;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 0 14px;
  border-bottom: 1px solid #28303b;
  background: #181d25;
  color: #8e9aad;
  font-size: 0.68rem;
}

.terminal-dots {
  display: flex;
  gap: 6px;
}

.terminal-dots span {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #ff5f57;
}

.terminal-dots span:nth-child(2) {
  background: #febc2e;
}

.terminal-dots span:nth-child(3) {
  background: #28c840;
}

.terminal-card__status {
  margin-left: auto;
  color: #78d79a;
  white-space: nowrap;
}

.terminal-card__body {
  min-width: 0;
  padding: 24px 16px;
  color: #d5dbe4;
  font-size: clamp(0.7rem, 2.4vw, 0.82rem);
  line-height: 1.85;
}

.terminal-card__body p {
  min-width: 0;
  margin: 0;
  overflow-wrap: anywhere;
}

.token-muted {
  color: #536071;
  user-select: none;
}

.token-key {
  color: #ff7a55;
}

.token-prop {
  color: #70d6ff;
}

.token-string {
  color: #9de7b7;
}

.terminal-caret {
  display: inline-block;
  width: 7px;
  height: 1.1em;
  margin-left: 5px;
  vertical-align: -0.15em;
  background: var(--accent);
  animation: blink 1.1s steps(1) infinite;
}

.terminal-card__footer {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  padding: 8px 14px;
  border-top: 1px solid #28303b;
  background: #ff6037;
  color: #fff;
  font-size: 0.61rem;
}

.orbit-tag {
  position: absolute;
  display: none;
  padding: 8px 11px;
  border: 1px solid var(--line-strong);
  border-radius: 8px;
  background: var(--surface);
  box-shadow: var(--shadow);
  color: var(--text-soft);
  font-size: 0.65rem;
}

.orbit-tag--one {
  top: -22px;
  right: -18px;
  transform: rotate(4deg);
}

.orbit-tag--two {
  bottom: -21px;
  left: -24px;
  transform: rotate(-3deg);
  color: var(--green);
}

/* =========================
   Section headings
========================= */
.section-heading {
  max-width: 760px;
  margin: 0 auto clamp(42px, 7vw, 74px);
  text-align: center;
}

.section-heading--left {
  margin: 0 0 28px;
  text-align: left;
}

.section-heading__label {
  margin-bottom: 13px;
  color: var(--accent);
  font-size: 0.72rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.section-heading h2 {
  margin-bottom: 18px;
  font-size: clamp(2rem, 7vw, 3.8rem);
  letter-spacing: -0.06em;
}

.section-heading>p:last-child {
  margin-bottom: 0;
  color: var(--text-soft);
}

.section-heading--project {
  max-width: none;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 18px;
  margin-inline: 0;
  text-align: left;
}

.section-heading--project h2 {
  margin-bottom: 0;
}

/* =========================
   About
========================= */
.about {
  display: grid;
  gap: 54px;
  align-items: center;
}

.about__media {
  position: relative;
  width: min(100%, 520px);
  margin-inline: auto;
}

.photo-frame {
  position: relative;
  padding: 10px;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--surface);
}

.photo-frame::before {
  position: absolute;
  inset: 28px -16px -16px 28px;
  z-index: -1;
  content: "";
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
}

.photo-frame img {
  width: 100%;
  aspect-ratio: 4 / 4.6;
  border-radius: calc(var(--radius-lg) - 8px);
  object-fit: cover;
  object-position: center 24%;
  filter: saturate(0.86) contrast(1.03);
}

.photo-frame__index {
  position: absolute;
  top: 26px;
  left: 26px;
  padding: 5px 9px;
  border-radius: 6px;
  background: rgba(8, 10, 13, 0.76);
  color: #fff;
  font-size: 0.64rem;
  backdrop-filter: blur(8px);
}

.about__availability {
  position: relative;
  width: calc(100% - 28px);
  display: flex;
  align-items: center;
  gap: 14px;
  margin: -32px auto 0;
  padding: 16px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--surface);
  box-shadow: var(--shadow);
}

.about__availability div {
  min-width: 0;
}

.about__availability strong,
.about__availability span {
  display: block;
}

.about__availability strong {
  font-size: 0.84rem;
}

.about__availability div span {
  overflow: hidden;
  color: var(--text-faint);
  font-size: 0.7rem;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.about__content {
  color: var(--text-soft);
}

.about__lead {
  color: var(--text);
  font-size: 1.12rem;
  font-weight: 600;
}

.about__highlights {
  display: grid;
  gap: 9px;
  margin-top: 28px;
}

.about__highlights li {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 11px 0;
  border-bottom: 1px solid var(--line);
  color: var(--text);
  font-size: 0.9rem;
  font-weight: 600;
}

.about__highlights li span {
  color: var(--accent);
  font-size: 0.7rem;
}

/* =========================
   Skills
========================= */
.skill-groups {
  display: grid;
  gap: 14px;
}

.skill-group {
  position: relative;
  display: grid;
  grid-template-columns: auto minmax(0, 1fr);
  gap: 18px;
  padding: 24px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--surface);
  transition: transform 0.35s var(--ease), border-color 0.3s ease, box-shadow 0.3s ease;
}

.skill-group::after {
  position: absolute;
  right: -60px;
  bottom: -80px;
  width: 170px;
  aspect-ratio: 1;
  content: "";
  border-radius: 50%;
  background: var(--accent-soft);
  filter: blur(6px);
  opacity: 0;
  transition: opacity 0.3s ease;
}

.skill-group:hover {
  transform: translateY(-4px);
  border-color: var(--line-strong);
  box-shadow: var(--shadow);
}

.skill-group:hover::after {
  opacity: 1;
}

.skill-group__number {
  position: relative;
  z-index: 1;
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 50%;
  color: var(--accent);
  font-size: 0.65rem;
}

.skill-group>div:last-child {
  position: relative;
  z-index: 1;
  min-width: 0;
}

.skill-group__eyebrow {
  margin-bottom: 6px;
  color: var(--text-faint);
  font-size: 0.66rem;
}

.skill-group h3 {
  margin-bottom: 12px;
  font-size: 1.35rem;
  letter-spacing: -0.035em;
}

.skill-group p:not(.skill-group__eyebrow) {
  margin-bottom: 20px;
  color: var(--text-soft);
  font-size: 0.9rem;
}

.tag-list {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.tag-list li {
  padding: 6px 10px;
  border: 1px solid var(--line);
  border-radius: 999px;
  background: var(--bg);
  color: var(--text-soft);
  font-family: "JetBrains Mono", monospace;
  font-size: 0.65rem;
  line-height: 1.2;
}

.tag-list--accent li {
  border-color: rgba(255, 96, 55, 0.34);
  background: rgba(255, 96, 55, 0.1);
  color: #ffc0af;
}

.tag-list--compact {
  gap: 6px;
}

.tag-list--compact li {
  background: transparent;
}

/* =========================
   Projects
========================= */
.section-shell--ink .section-heading__label {
  color: #ff7955;
}

.featured-project {
  display: grid;
  overflow: hidden;
  border: 1px solid #2d3541;
  border-radius: var(--radius-lg);
  background: #12171e;
  box-shadow: 0 35px 100px rgba(0, 0, 0, 0.24);
}

.featured-project__visual {
  position: relative;
  min-height: 360px;
  display: grid;
  place-items: center;
  padding: clamp(26px, 7vw, 70px);
  overflow: hidden;
  background: radial-gradient(circle at 25% 20%, rgba(255, 96, 55, 0.2), transparent 34%), linear-gradient(145deg, #171d26, #0e1218);
}

.featured-project__visual::before {
  position: absolute;
  inset: 0;
  content: "";
  background-image: linear-gradient(rgba(255, 255, 255, .035) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, .035) 1px, transparent 1px);
  background-size: 30px 30px;
  mask-image: linear-gradient(to bottom right, black, transparent 78%);
}

.featured-project__label {
  position: absolute;
  bottom: 16px;
  left: 18px;
  color: #748093;
  font-size: 0.63rem;
}

.dashboard-mock {
  position: relative;
  z-index: 1;
  width: min(100%, 530px);
  aspect-ratio: 1.48;
  display: grid;
  grid-template-columns: 16% 1fr;
  overflow: hidden;
  border: 1px solid #3b4655;
  border-radius: 13px;
  background: #11161d;
  box-shadow: 0 25px 70px rgba(0, 0, 0, .42);
  transform: perspective(900px) rotateY(-6deg) rotateX(2deg);
}

.dashboard-mock__rail {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
  padding: 12px 8px;
  border-right: 1px solid #2b333e;
  background: #171c23;
}

.dashboard-mock__rail span:not(.dashboard-mock__logo) {
  width: 52%;
  height: 5px;
  border-radius: 4px;
  background: #303947;
}

.dashboard-mock__logo {
  width: 24px;
  height: 24px;
  display: grid;
  place-items: center;
  margin-bottom: 9px;
  border-radius: 7px;
  background: var(--accent);
  color: #fff;
  font-weight: 800;
}

.dashboard-mock__main {
  display: grid;
  grid-template-rows: auto auto 1fr auto;
  gap: 10px;
  padding: 13px;
}

.dashboard-mock__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dashboard-mock__top span:first-child {
  width: 30%;
  height: 7px;
  border-radius: 5px;
  background: #e2e7ee;
}

.dashboard-mock__top span:last-child {
  width: 22px;
  height: 22px;
  border-radius: 50%;
  background: #303947;
}

.dashboard-mock__stats {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 7px;
}

.dashboard-mock__stats span {
  height: clamp(34px, 8vw, 58px);
  border: 1px solid #303946;
  border-radius: 7px;
  background: #1a2029;
}

.dashboard-mock__stats span:first-child {
  border-color: rgba(255, 96, 55, .55);
  background: rgba(255, 96, 55, .12);
}

.dashboard-mock__chart {
  min-height: 95px;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  gap: 5px;
  padding: 12px;
  border: 1px solid #303946;
  border-radius: 8px;
  background: #151a22;
}

.dashboard-mock__chart i {
  width: 9%;
  height: 30%;
  border-radius: 3px 3px 0 0;
  background: #404b5b;
}

.dashboard-mock__chart i:nth-child(2) {
  height: 55%;
}

.dashboard-mock__chart i:nth-child(3) {
  height: 42%;
}

.dashboard-mock__chart i:nth-child(4) {
  height: 78%;
  background: var(--accent);
}

.dashboard-mock__chart i:nth-child(5) {
  height: 63%;
}

.dashboard-mock__chart i:nth-child(6) {
  height: 88%;
}

.dashboard-mock__table {
  display: grid;
  gap: 5px;
}

.dashboard-mock__table span {
  height: 5px;
  border-radius: 5px;
  background: #303946;
}

.dashboard-mock__table span:nth-child(2) {
  width: 84%;
}

.dashboard-mock__table span:nth-child(3) {
  width: 92%;
}

.dashboard-mock__table span:nth-child(4) {
  width: 75%;
}

.featured-project__content {
  padding: clamp(28px, 7vw, 58px);
}

.project-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  gap: 8px;
  margin-bottom: 18px;
  color: #8995a6;
  font-size: 0.7rem;
}

.featured-project__content h3 {
  margin-bottom: 18px;
  font-size: clamp(2.2rem, 8vw, 4.1rem);
  letter-spacing: -0.065em;
}

.featured-project__content>p {
  color: #aeb8c6;
}

.feature-list {
  display: grid;
  gap: 8px;
  margin: 24px 0;
  color: #d7dde5;
  font-size: 0.86rem;
}

.feature-list li {
  position: relative;
  padding-left: 19px;
}

.feature-list li::before {
  position: absolute;
  top: 0.7em;
  left: 0;
  width: 7px;
  height: 1px;
  content: "";
  background: var(--accent);
}

.project-grid {
  display: grid;
  gap: 14px;
  margin-top: 14px;
}

.project-card {
  min-height: 390px;
  display: flex;
  flex-direction: column;
  padding: 25px;
  border: 1px solid #2d3541;
  border-radius: var(--radius-md);
  background: #12171e;
  transition: transform 0.35s var(--ease), border-color 0.3s ease, background 0.3s ease;
}

.project-card:hover {
  transform: translateY(-6px);
  border-color: #4a5667;
  background: #151b23;
}

.project-card__top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 34px;
}

.project-card__index {
  color: #6f7b8d;
  font-size: 0.65rem;
}

.project-card__icon {
  width: 43px;
  height: 43px;
  display: grid;
  place-items: center;
  border: 1px solid #303946;
  border-radius: 12px;
  color: #ff7955;
  font-size: 0.76rem;
}

.project-card__type {
  margin-bottom: 8px;
  color: #798597;
  font-size: 0.63rem;
}

.project-card h3 {
  margin-bottom: 14px;
  font-size: 1.55rem;
}

.project-card>p:not(.project-card__type) {
  margin-bottom: 22px;
  color: #a7b1bf;
  font-size: 0.88rem;
}

.project-card__link {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  margin-top: auto;
  padding-top: 22px;
  border-top: 1px solid #29313c;
  color: #eef2f6;
  font-size: 0.85rem;
  font-weight: 700;
}

.project-card__link span {
  color: #ff7955;
  transition: transform 0.25s var(--ease);
}

.project-card__link:hover span {
  transform: translate(3px, -3px);
}

/* =========================
   Journey
========================= */
.journey {
  display: grid;
  gap: 48px;
  align-items: start;
}

.timeline {
  position: relative;
}

.timeline::before {
  position: absolute;
  top: 10px;
  bottom: 8px;
  left: 6px;
  width: 1px;
  content: "";
  background: var(--line);
}

.timeline__item {
  position: relative;
  display: grid;
  grid-template-columns: 1fr;
  gap: 8px;
  padding: 0 0 46px 32px;
}

.timeline__item:last-child {
  padding-bottom: 0;
}

.timeline__marker {
  position: absolute;
  top: 7px;
  left: 0;
  width: 13px;
  height: 13px;
  border: 3px solid var(--bg);
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 0 1px var(--accent);
}

.timeline__date {
  color: var(--accent);
  font-size: 0.66rem;
}

.timeline__kind {
  margin-bottom: 7px;
  color: var(--text-faint);
  font-size: 0.64rem;
  text-transform: uppercase;
}

.timeline__content h3 {
  margin-bottom: 5px;
  font-size: 1.35rem;
}

.timeline__org {
  margin-bottom: 15px;
  color: var(--text-soft);
  font-size: 0.86rem;
}

.timeline__content ul {
  display: grid;
  gap: 6px;
}

.timeline__content li {
  position: relative;
  padding-left: 16px;
  color: var(--text-soft);
  font-size: 0.86rem;
}

.timeline__content li::before {
  position: absolute;
  top: 0.77em;
  left: 0;
  width: 6px;
  height: 1px;
  content: "";
  background: var(--accent);
}

.credentials {
  padding: 26px;
  border: 1px solid var(--line);
  border-radius: var(--radius-md);
  background: var(--surface);
}

.credentials__label {
  margin-bottom: 9px;
  color: var(--accent);
  font-size: 0.66rem;
}

.credentials h3 {
  margin-bottom: 24px;
  font-size: 1.35rem;
}

.credentials ul {
  display: grid;
}

.credentials li {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 13px 0;
  border-bottom: 1px solid var(--line);
  color: var(--text-soft);
  font-size: 0.83rem;
}

.credentials li:last-child {
  border-bottom: 0;
}

.credentials li span {
  color: var(--text-faint);
  font-family: "JetBrains Mono", monospace;
  font-size: 0.6rem;
  text-transform: uppercase;
}

/* =========================
   Contact and footer
========================= */
.contact-section {
  padding-top: 20px;
}

.contact-card {
  position: relative;
  display: grid;
  gap: 40px;
  padding: clamp(28px, 7vw, 70px);
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: var(--radius-lg);
  background: var(--surface);
  box-shadow: var(--shadow);
}

.contact-card::before {
  position: absolute;
  top: -170px;
  right: -140px;
  width: 390px;
  aspect-ratio: 1;
  content: "";
  border-radius: 50%;
  background: radial-gradient(circle, var(--accent-soft), transparent 68%);
}

.contact-card__content {
  position: relative;
  z-index: 1;
}

.contact-card h2 {
  max-width: 720px;
  margin-bottom: 22px;
  font-size: clamp(2rem, 7vw, 3.8rem);
  letter-spacing: -0.06em;
}

.contact-card__content>p:not(.section-heading__label) {
  max-width: 62ch;
  color: var(--text-soft);
}

.contact-card__actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
  margin-top: 28px;
}

.copy-email {
  min-width: 146px;
}

.copy-email__success {
  display: none;
  color: var(--green);
}

.copy-email.is-copied .copy-email__default {
  display: none;
}

.copy-email.is-copied .copy-email__success {
  display: inline;
}

.contact-links {
  position: relative;
  z-index: 1;
  display: grid;
}

.contact-links a {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
  padding: 19px 4px;
  border-bottom: 1px solid var(--line);
  transition: padding 0.25s var(--ease), color 0.25s ease;
}

.contact-links a:first-child {
  border-top: 1px solid var(--line);
}

.contact-links a:hover {
  padding-inline: 10px;
  color: var(--accent);
}

.contact-links a>span:first-child {
  display: flex;
  align-items: center;
  gap: 13px;
}

.contact-links small {
  color: var(--text-faint);
  font-size: 0.62rem;
  font-weight: 400;
}

.contact-links strong {
  font-size: 0.92rem;
}

.footer {
  padding-block: 32px;
  border-top: 1px solid var(--line);
}

.footer__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 15px;
  text-align: center;
}

.brand--footer {
  font-size: 0.9rem;
}

.footer p {
  margin: 0;
  color: var(--text-faint);
  font-size: 0.72rem;
}

.footer__top {
  color: var(--text-soft);
  font-size: 0.7rem;
}

.footer__top:hover {
  color: var(--accent);
}

/* =========================
   Reveal and motion
========================= */
.reveal {
  opacity: 0;
  transform: translateY(28px);
  transition: opacity 0.8s var(--ease), transform 0.8s var(--ease);
}

.reveal.is-visible {
  opacity: 1;
  transform: translateY(0);
}

@keyframes blink {

  0%,
  46% {
    opacity: 1;
  }

  47%,
  100% {
    opacity: 0;
  }
}

@keyframes scroll-cue {
  0%, 100% {
    transform: translateY(-3px);
  }

  50% {
    transform: translateY(4px);
  }
}

/* =========================
   Tablet
========================= */
@media (min-width: 640px) {
  .container {
    width: min(100% - 64px, var(--container));
  }

  .hero__facts {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .hero__facts div:last-child {
    grid-column: auto;
  }

  .orbit-tag {
    display: block;
  }

  .terminal-card__body {
    padding: 28px;
  }

  .section-heading--project {
    flex-direction: row;
    align-items: end;
    justify-content: space-between;
  }

  .skill-group {
    gap: 26px;
    padding: 30px;
  }

  .project-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .project-card:last-child {
    grid-column: 1 / -1;
  }

  .timeline__item {
    grid-template-columns: 150px minmax(0, 1fr);
    padding-left: 36px;
  }

  .timeline__date {
    padding-top: 4px;
  }

  .credentials li {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 12px;
  }

  .footer__inner {
    flex-direction: row;
    justify-content: space-between;
    text-align: left;
  }
}

/* =========================
   Desktop
========================= */
@media (min-width: 900px) {
  :root {
    --header-height: 78px;
  }

  .menu-toggle {
    display: none;
  }

  .nav {
    position: static;
    width: auto;
    height: auto;
    margin-left: auto;
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 4px;
    padding: 0;
    border: 0;
    background: transparent;
    box-shadow: none;
    opacity: 1;
    clip-path: none;
    pointer-events: auto;
    visibility: visible;
  }

  .nav__link {
    position: relative;
    padding: 9px 10px;
    border: 0;
    font-size: 0.77rem;
  }

  .nav__link::after {
    position: absolute;
    right: 10px;
    bottom: 3px;
    left: 10px;
    height: 1px;
    content: "";
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }

  .nav__link:hover::after,
  .nav__link.is-active::after {
    transform: scaleX(1);
  }

  .nav__resume {
    margin: 0 4px 0 8px;
  }

  .theme-toggle {
    width: 40px;
    height: 40px;
  }

  .nav-backdrop {
    display: none !important;
  }

  body.menu-open {
    overflow: auto;
  }

  .hero__grid {
    grid-template-columns: minmax(0, 1.08fr) minmax(390px, 0.92fr);
    gap: clamp(54px, 7vw, 100px);
  }

  .hero__content {
    max-width: none;
  }

  .hero__facts {
    max-width: 670px;
  }

  .about {
    grid-template-columns: minmax(330px, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(70px, 9vw, 130px);
  }

  .about__media {
    margin-inline: 0;
  }

  .skill-groups {
    grid-template-columns: repeat(3, minmax(0, 1fr));
    align-items: stretch;
  }

  .skill-group {
    grid-template-columns: 1fr;
    grid-template-rows: auto 1fr;
  }

  .skill-group__number {
    margin-bottom: 10px;
  }

  .featured-project {
    grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.95fr);
  }

  .featured-project__visual {
    min-height: 610px;
  }

  .project-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .project-card:last-child {
    grid-column: auto;
  }

  .journey {
    grid-template-columns: minmax(0, 1.25fr) minmax(330px, 0.75fr);
    gap: clamp(60px, 9vw, 120px);
  }

  .credentials {
    position: sticky;
    top: calc(var(--header-height) + 30px);
  }

  .contact-card {
    grid-template-columns: minmax(0, 1.25fr) minmax(300px, 0.75fr);
    align-items: end;
  }
}

@media (min-width: 1160px) {
  .nav__link {
    padding-inline: 13px;
  }

  .nav__link::after {
    right: 13px;
    left: 13px;
  }

  .hero h1 {
    font-size: clamp(4.5rem, 6.35vw, 5.7rem);
  }
}

@media (max-width: 380px) {
  .container {
    width: min(100% - 28px, var(--container));
  }

  .button {
    width: 100%;
  }

  .hero__actions,
  .contact-card__actions {
    display: grid;
    width: 100%;
  }

  .hero__facts div {
    padding: 14px 12px;
  }

  .featured-project__visual {
    min-height: 300px;
    padding: 20px;
  }

  .project-card {
    min-height: 0;
  }
}

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    scroll-behavior: auto !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }

  .reveal {
    opacity: 1;
    transform: none;
  }
}
